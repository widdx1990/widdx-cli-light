{
  "provider": {
    "name": "opencode-zen",
    "model": "deepseek-v4-flash-free"
  },
  "max_turns": 20,
  "temperature": 0.9,
  "mcp_servers": [
    {
      "name": "filesystem",
      "command": "node",
      "args": [
        "/home/widdx/widdx-cli-light/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js",
        "/home/widdx/widdx-cli-light"
      ]
    },
    {
      "name": "memory",
      "command": "node",
      "args": [
        "/home/widdx/widdx-cli-light/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ]
    },
    {
      "name": "fetch",
      "command": "uvx",
      "args": [
        "mcp-server-fetch",
        "--ignore-robots-txt"
      ]
    },
    {
      "name": "sequential-thinking",
      "command": "node",
      "args": [
        "/home/widdx/widdx-cli-light/node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"
      ]
    },
    {
      "name": "playwright",
      "command": "node",
      "args": [
        "/home/widdx/widdx-cli-light/node_modules/@playwright/mcp/cli.js"
      ]
    },
    {
      "name": "sqlite",
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "/home/widdx/widdx-cli-light/.widdx/data/mcp_data.db"
      ]
    }
  ]
}